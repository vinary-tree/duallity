{
  "name": "@vinary-tree/duallity",
  "version": "0.3.0",
  "description": "Modular JavaScript, TypeScript, and ClojureScript bindings for duallity",
  "author": { "name": "Dylon Edwards", "email": "dylon.devo@gmail.com" },
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinary-tree/duallity.git",
    "directory": "bindings/javascript"
  },
  "engines": { "node": ">=22.14" },
  "dependencies": {
    "@vinary-tree/interop": "0.1.0",
    "@vinary-tree/vinary-tree": "0.10.0"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./facades/native.mjs", "require": "./facades/native.cjs" },
    "./typescript": { "types": "./index.d.ts", "import": "./facades/typescript.mjs", "require": "./facades/typescript.cjs" },
    "./clojurescript": { "types": "./index.d.ts", "import": "./facades/clojurescript.mjs", "require": "./facades/clojurescript.cjs" },
    "./wasm": { "types": "./index.d.ts", "import": "./facades/wasm.mjs" },
    "./wasi": { "types": "./index.d.ts", "import": "./facades/wasi.mjs" },
    "./cljs/vinary_tree/duallity.cljs": "./cljs/vinary_tree/duallity.cljs"
  },
  "cljs": { "namespaces": { "vinary-tree.duallity": "./cljs/vinary_tree/duallity.cljs" } },
  "files": ["index.d.ts", "facades/", "cljs/", "deps.cljs", "README.md"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": { "test": "node --test test/facades.test.mjs", "prepack": "npm test" }
}
