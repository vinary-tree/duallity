    'duallity_wfst_new' => 'DUALLITY_API DuallityStatus duallity_wfst_new(VtResource dictionary, const uint8_t* query_data, size_t query_len, size_t maximum_distance, uint32_t algorithm, uint32_t kind, DuallityWfst** out_wfst);',
    'duallity_wfst_new_ref' => 'DUALLITY_API DuallityStatus duallity_wfst_new_ref(const VtResource* dictionary, const uint8_t* query_data, size_t query_len, size_t maximum_distance, uint32_t algorithm, uint32_t kind, DuallityWfst** out_wfst);',
    'duallity_wfst_free' => 'DUALLITY_API void duallity_wfst_free(DuallityWfst* wfst);',
