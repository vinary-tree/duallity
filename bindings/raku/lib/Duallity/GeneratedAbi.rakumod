    'VtResource' => 'reference-counted-retain',
);

our constant C-SIGNATURES is export = Map.new(
    'duallity_abi_version' => 'DUALLITY_API uint32_t duallity_abi_version(void);',
    'duallity_api_revision' => 'DUALLITY_API uint32_t duallity_api_revision(void);',
