    UNIVERSAL-MERGE-AND-SPLIT => 3,
    GENERALIZED-STANDARD => 4,
    GENERALIZED-TRANSPOSITION => 5,
    GENERALIZED-MERGE-AND-SPLIT => 6,
    GENERALIZED-PHONETIC => 7,
    FZF => 8,
);

our constant TYPE-KINDS is export = Map.new(
