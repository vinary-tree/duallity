// D6 — Characteristic vector over the relevant-subword window.
// Depicts: s_n(w, i) — the sliding window of the term w that the universal automaton inspects at
// query position i, and the characteristic bit vector χ(c, window) for a candidate char c.
// Example: w = "hello", n = 1 (max distance), i = 2, c = 'l'  ⇒  window = "ell", χ('l',·) = [0,1,1].
digraph CharVector {
  rankdir=TB;
  bgcolor="#FFFFFF";
  fontname="DejaVu Sans";
  labelloc="t";
  label="D6 · Relevant subword s_n(w,i) and characteristic vector χ(c, ·)\nw = \"hello\",  n = 1,  i = 2,  c = 'l'   ⇒   window = \"ell\",   χ('l', \"ell\") = [0, 1, 1]";
  node [shape=box, style=filled, fontname="DejaVu Sans", fontsize=12, width=0.6, height=0.6, fixedsize=true];

  // term w = h e l l o  (cells); window covers e,l,l (teal); rest plain
  subgraph cluster_term {
    label="term  w = \"hello\""; labelloc="b"; color="#AAB7B8"; style="rounded";
    rank=same;
    w0 [label="h", fillcolor="#FFFFFF"];
    w1 [label="e", fillcolor="#D1F2EB"];
    w2 [label="l", fillcolor="#D1F2EB"];
    w3 [label="l", fillcolor="#D1F2EB"];
    w4 [label="o", fillcolor="#FFFFFF"];
    w0 -> w1 -> w2 -> w3 -> w4 [style=invis];
  }

  // characteristic vector for c='l' over the window (e,l,l) -> 0,1,1
  subgraph cluster_chi {
    label="χ('l', window)"; labelloc="b"; color="#AAB7B8"; style="rounded";
    rank=same;
    c1 [label="0", fillcolor="#EAECEE"];
    c2 [label="1", fillcolor="#F9E79F"];
    c3 [label="1", fillcolor="#F9E79F"];
    c1 -> c2 -> c3 [style=invis];
  }

  // map window cells down to bits
  w1 -> c1 [label=" e ≠ l ", color="#85929E", fontsize=9, fontname="DejaVu Sans"];
  w2 -> c2 [label=" l = l ", color="#1E8449", fontsize=9, fontname="DejaVu Sans"];
  w3 -> c3 [label=" l = l ", color="#1E8449", fontsize=9, fontname="DejaVu Sans"];

  note [shape=note, fillcolor="#FCF3CF", style=filled, fontsize=10,
        label="The universal automaton is query-agnostic.\nA dictionary term enters only through χ(c, s_n(w,i)).\nPositions i < 1 are padded with '$' (out of bounds)."];
  note -> w0 [style=invis];
}
