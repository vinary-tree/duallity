prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: duallity
Description: Lazy dictionary-backed edit and phonetic WFST adapters
Version: 4.0.0-rc.1
Requires: vinary-tree-interop = 4.0.0-rc.1
Libs: -L${libdir} -lduallity
Libs.private: -ldl -lpthread -lm
Cflags: -I${includedir}
