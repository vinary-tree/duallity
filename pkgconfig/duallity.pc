prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: duallity
Description: Fuzzy-search transducers for phonetics, grammars, and language models
Version: 4.0.0-rc.6
Requires: vinary-tree-interop = 4.0.0-rc.6
Libs: -L${libdir} -lduallity
Libs.private: -ldl -lpthread -lm
Cflags: -I${includedir}
